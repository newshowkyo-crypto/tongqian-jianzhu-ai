# 环境变量示例
# 真实 .env 文件不进 git，仅本地开发用

# ============================================
# 应用基础
# ============================================
NODE_ENV=development
APP_NAME=tongqian-jianzhu-ai
APP_PORT=3000
API_PORT=4000
WORKER_PORT=4100
ADMIN_PORT=3001
AGENT_PORT=3002
GOV_PORT=3003

# 时区
TZ=Asia/Shanghai

# ============================================
# 数据库
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tongqian_dev?schema=public"
DATABASE_POOL_MAX=20

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX=tqj_dev:

# DashVector（向量库）
DASHVECTOR_ENDPOINT=
DASHVECTOR_API_KEY=
DASHVECTOR_COLLECTION=tongqian_main

# ============================================
# 阿里云
# ============================================
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# OSS 文件存储
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=tongqian-files
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# OCR / 文档智能
OCR_ENDPOINT=https://ocr-api.cn-hangzhou.aliyuncs.com
DOC_INTELLIGENCE_ENDPOINT=https://docmind-api.cn-hangzhou.aliyuncs.com

# 国产 AI 旗舰双主路径（M3.12）
# 深度推理：DeepSeek R1 直连 deepseek-reasoner
# 日常文本/政企/长任务：阿里百炼 qwen3-max
# 多模态视觉：阿里百炼 qwen3-vl-max
# 向量/Embedding：阿里百炼 text-embedding-v3 + DashVector
ALIYUN_DASHSCOPE_API_KEY=
DASHSCOPE_API_KEY= # optional alias for local tooling
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================
# 火山引擎方舟（V4 IMPROVEMENTS 已移除，DeepSeek 直连替代）
# ============================================
# VOLC_ARK_API_KEY=（已废弃）
# VOLC_ARK_BASE_URL=（已废弃）

# ============================================
# DeepSeek 直连（M3.12 旗舰推理：deepseek-reasoner）
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============================================
# 海外模型渠道（M3.12 已废弃，不再调用）
# ============================================
# OPENROUTER_API_KEY=DEPRECATED_DO_NOT_USE
# OPENROUTER_BASE_URL=DEPRECATED_DO_NOT_USE

# B.AI（备用，若 OpenRouter 不稳）
# BAI_API_KEY=DEPRECATED_DO_NOT_USE
# BAI_BASE_URL=DEPRECATED_DO_NOT_USE

# 二期切换（HK 公司注册后）：Anthropic / OpenAI 直连
# ANTHROPIC_API_KEY=DEPRECATED_DO_NOT_USE
# OPENAI_API_KEY=DEPRECATED_DO_NOT_USE

# ============================================
# 微信
# ============================================
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_TOKEN=
WECHAT_AESKEY=

# 微信支付
WECHAT_PAY_MCHID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://api.tongqian.com/api/v1/payments/wechat/notify

# 企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=

# ============================================
# 支付宝
# ============================================
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.tongqian.com/api/v1/payments/alipay/notify

# ============================================
# 短信
# ============================================
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=同乾方略
SMS_TEMPLATE_OTP=SMS_xxxxx

# ============================================
# 安全密钥
# ============================================
JWT_SECRET=replace-with-random-256bit-hex
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=30d

# 加密密钥（AES-256-GCM）
ENCRYPTION_KEY=replace-with-32byte-random-hex

# CSRF
CSRF_SECRET=replace-with-random-string

# ============================================
# 日志
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ============================================
# 监控
# ============================================
SENTRY_DSN=
OPENTELEMETRY_ENDPOINT=

# ============================================
# 限流
# ============================================
RATE_LIMIT_GLOBAL_PER_SEC=10
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_AI_PER_MIN=30

# ============================================
# 文件上传
# ============================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,bmp,tiff

# ============================================
# 业务配置
# ============================================
# 客户保护期（天）
CUSTOMER_PROTECTION_DAYS=7

# 中介首年订阅分润比例（V4 双轨命名：代码层保留 AGENT 标识）
AGENT_FIRST_YEAR_RATE=0.30
AGENT_NEXT_YEAR_RATE=0.20
AGENT_RECHARGE_RATE=0.15
AGENT_REFER_AGENT_RATE=0.10
CROSS_DISPATCH_RATE=0.05

# V4 IMPROVEMENTS · PARTNER 智能管家代理人分润（二期 M4 启用）
PARTNER_SUBSCRIPTION_RATE=0.05
PARTNER_TOPUP_RATE=0.03
PARTNER_REFER_AGENT_RATE=0.05
PARTNER_REFER_AGENT_BONUS=100
PARTNER_REFER_TONGQIAN_RATE=0.05
PARTNER_YEAR_LIMIT_OWNERS=50
PARTNER_YEAR_LIMIT_AGENTS=20
PARTNER_ACTIVATION_DAYS=30
FEATURE_FLAG_PARTNER_ENABLED=false  # 一期关闭 / 二期 M4 开启

# 提现门槛（元）
WITHDRAW_MIN_AMOUNT=100

# ============================================
# 默认 AI 模型成本（元/百万 tokens，可在后台覆盖）
# ============================================
# M3.12 国产旗舰默认成本（元 / 百万 tokens，可在后台覆盖）
COST_QWEN3_MAX_INPUT=20
COST_QWEN3_MAX_OUTPUT=60
COST_QWEN3_VL_MAX_INPUT=30
COST_QWEN3_VL_MAX_OUTPUT=90
COST_TEXT_EMBEDDING_V3_INPUT=0.7
COST_DEEPSEEK_REASONER_INPUT=4
COST_DEEPSEEK_REASONER_OUTPUT=16

# ============================================
# 公开域名
# ============================================
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_ADMIN_URL=http://localhost:3001
PUBLIC_AGENT_URL=http://localhost:3002
PUBLIC_GOV_URL=http://localhost:3003

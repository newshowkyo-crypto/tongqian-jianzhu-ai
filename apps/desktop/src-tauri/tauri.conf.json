{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "同乾方略 · 建筑 AI 经营管家",
  "version": "0.1.0",
  "identifier": "com.tongqian.jianzhu",
  "build": {
    "beforeDevCommand": "pnpm --filter @tongqian/web dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist/web-static"
  },
  "app": {
    "windows": [
      {
        "title": "同乾方略 · 建筑 AI 经营管家",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "湖北省同乾咨询有限公司",
    "copyright": "© 2026 湖北省同乾咨询有限公司",
    "icon": [
      "../../../packages/ui/src/assets/app-icons/app-icon-32.png",
      "../../../packages/ui/src/assets/app-icons/app-icon-128.png",
      "../../../packages/ui/src/assets/app-icons/app-icon-256.png",
      "../../../packages/ui/src/assets/app-icons/app-icon-512.png",
      "../../../packages/ui/src/assets/app-icons/app-icon-1024.png",
      "icons/icon.ico"
    ],
    "targets": ["msi", "nsis"],
    "resources": ["../dist/web-standalone/**/*"],
    "windows": {
      "signCommand": "signtool.exe sign /f $env:CERT_PATH /p $env:CERT_PASSWORD /t http://timestamp.digicert.com $TARGET",
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": ["https://download.tongqianjianzhu.com/desktop/latest.json"],
      "pubkey": "PLACEHOLDER_REPLACE_WITH_TAURI_SIGN_GENERATE"
    }
  }
}

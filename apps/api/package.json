{
  "name": "@tongqian/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API application for the Tongqian platform.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node --import tsx --test src/modules/subscription/discount-rebate.service.spec.ts src/modules/risk-review/red-flag-scan.service.spec.ts src/modules/cost-catalog/cost-catalog.service.spec.ts src/modules/owner-risk/owner-risk.service.spec.ts src/modules/market-situation/market-situation.service.spec.ts src/modules/admin/credentials/credentials-admin.service.spec.ts",
    "test:golden": "node ../../scripts/run-m36-golden.mjs",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "5.22.0",
    "@tongqian/constants": "workspace:^",
    "@tongqian/errors": "workspace:*",
    "@tongqian/permissions": "workspace:*",
    "@tongqian/types": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2"
  }
}

{
  "name": "@tongqian/worker",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS worker application for queues and scheduled jobs.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "echo \"No tests yet for @tongqian/worker\"",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@prisma/client": "5.22.0",
    "bullmq": "^5.34.1",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2"
  }
}

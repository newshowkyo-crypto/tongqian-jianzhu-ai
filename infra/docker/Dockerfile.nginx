FROM nginx:1.25-alpine

LABEL org.opencontainers.image.source="https://github.com/newshowkyo-crypto/tongqian-jianzhu-ai" \
      org.opencontainers.image.title="同乾方略 Nginx" \
      org.opencontainers.image.description="同乾方略 · 建筑 AI 经营管家反向代理"

RUN rm /etc/nginx/conf.d/default.conf

COPY infra/nginx/conf.d/*.conf /etc/nginx/conf.d/
COPY infra/nginx/html/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1

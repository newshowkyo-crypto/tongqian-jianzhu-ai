ARG APP_NAME

FROM node:22-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

FROM base AS deps
WORKDIR /app

ARG APP_NAME
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/${APP_NAME}/package.json apps/${APP_NAME}/package.json
COPY packages packages
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app

ARG APP_NAME
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/${APP_NAME}/node_modules ./apps/${APP_NAME}/node_modules
COPY --from=deps /app/packages ./packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/${APP_NAME} apps/${APP_NAME}

RUN pnpm --filter ./apps/${APP_NAME} build

FROM node:22-alpine AS runner
WORKDIR /app

ARG APP_NAME
LABEL org.opencontainers.image.source="https://github.com/newshowkyo-crypto/tongqian-jianzhu-ai" \
      org.opencontainers.image.title="同乾方略 Next 应用" \
      org.opencontainers.image.description="同乾方略 · 建筑 AI 经营管家前端应用"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP_NAME=${APP_NAME}
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1

CMD ["sh", "-c", "node apps/${APP_NAME}/server.js"]

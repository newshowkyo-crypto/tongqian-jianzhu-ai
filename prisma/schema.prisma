generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemConfig {
  id            String                @id @default(uuid()) @db.Uuid
  key           String                @unique
  value         Json
  description   String?
  isOverridable Boolean               @default(true) @map("is_overridable")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  history       SystemConfigHistory[]

  @@map("system_configs")
}

model SystemConfigHistory {
  id             String       @id @default(uuid()) @db.Uuid
  systemConfigId String       @map("system_config_id") @db.Uuid
  oldValue       Json?        @map("old_value")
  newValue       Json         @map("new_value")
  changedBy      String?      @map("changed_by")
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at")
  systemConfig   SystemConfig @relation(fields: [systemConfigId], references: [id], onDelete: Restrict)

  @@index([systemConfigId])
  @@map("system_config_history")
}

model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  type             TenantType
  subType          String?      @map("sub_type")
  name             String
  socialCreditCode String?      @unique @map("social_credit_code")
  status           TenantStatus @default(active)
  meta             Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([type, status])
  @@map("tenants")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  phone          String     @unique
  email          String?
  passwordHash   String     @map("password_hash")
  name           String
  primaryRole    UserRole   @map("primary_role")
  platformRole   String?    @map("platform_role")
  positionTags   String[]   @default([]) @map("position_tags")
  is2faEnabled   Boolean    @default(false) @map("is_2fa_enabled")
  totpSecret     String?    @map("totp_secret")
  status         UserStatus @default(active)
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  deviceId   String?   @map("device_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model ClientAttribution {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String   @unique @map("client_id") @db.Uuid
  agentId        String   @map("agent_id") @db.Uuid
  refCode        String   @map("ref_code")
  reassignedFrom String?  @map("reassigned_from") @db.Uuid
  boundAt        DateTime @default(now()) @map("bound_at")

  @@index([agentId])
  @@map("client_attributions")
}

model UserConsent {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  version   String
  ip        String?
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  @@unique([userId, type, version])
  @@map("user_consents")
}

model ApprovalTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  version     Int
  stepsSchema Json     @map("steps_schema")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([type, version])
  @@index([type, isActive])
  @@map("approval_templates")
}

model ApprovalFlow {
  id           String         @id @default(uuid()) @db.Uuid
  type         String
  status       ApprovalStatus @default(pending)
  resourceType String         @map("resource_type")
  resourceId   String         @map("resource_id")
  initiatorId  String         @map("initiator_id")
  tenantId     String?        @map("tenant_id") @db.Uuid
  templateId   String         @map("template_id") @db.Uuid
  meta         Json?
  expiresAt    DateTime?      @map("expires_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  closedAt     DateTime?      @map("closed_at")

  @@index([tenantId, status])
  @@index([type, status])
  @@map("approval_flows")
}

model ApprovalStep {
  id           String           @id @default(uuid()) @db.Uuid
  flowId       String           @map("flow_id") @db.Uuid
  stepNo       Int              @map("step_no")
  approverRole String           @map("approver_role")
  approverId   String?          @map("approver_id")
  required     Boolean          @default(true)
  requires2fa  Boolean          @default(false) @map("requires_2fa")
  decision     ApprovalDecision @default(pending)
  reason       String?
  signedAt     DateTime?        @map("signed_at")

  @@unique([flowId, stepNo])
  @@map("approval_steps")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id")
  userId       String?  @map("user_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  traceId      String   @map("trace_id")
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([traceId])
  @@map("audit_logs")
}

model IdempotencyRecord {
  key        String   @id
  method     String
  path       String
  statusCode Int      @map("status_code")
  response   Json
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}

model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  monthlyPrice    Decimal  @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice     Decimal? @map("yearly_price") @db.Decimal(10, 2)
  creditsPerMonth Int      @map("credits_per_month")
  features        Json
  isActive        Boolean  @default(true) @map("is_active")

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  planCode           String             @map("plan_code")
  status             SubscriptionStatus @default(trial)
  consecutiveMonths  Int                @default(0) @map("consecutive_months")
  autoRenew          Boolean            @default(true) @map("auto_renew")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  expiredAt          DateTime?          @map("expired_at")
  pastDueSince       DateTime?          @map("past_due_since")
  totalPaid          Decimal            @default(0) @map("total_paid") @db.Decimal(12, 2)
  totalPaidMonths    Int                @default(0) @map("total_paid_months")
  conciergeUserId    String?            @map("concierge_user_id")
  meta               Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([status, currentPeriodEnd])
  @@index([pastDueSince])
  @@map("subscriptions")
}

model SubscriptionChange {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  fromPlan       String   @map("from_plan")
  toPlan         String   @map("to_plan")
  type           String
  effectiveAt    DateTime @map("effective_at")
  prorateAmount  Decimal? @map("prorate_amount") @db.Decimal(10, 2)
  initiatedBy    String   @map("initiated_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@map("subscription_changes")
}

model RenewalAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  attemptNo      Int      @map("attempt_no")
  result         String
  paymentId      String?  @map("payment_id")
  errorCode      String?  @map("error_code")
  attemptedAt    DateTime @default(now()) @map("attempted_at")

  @@index([subscriptionId, attemptNo])
  @@map("renewal_attempts")
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  invoiceNo      String   @unique @map("invoice_no")
  invoiceUrl     String?  @map("invoice_url")
  emailSentAt    DateTime? @map("email_sent_at")
  status         String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("invoices")
}

model CreditAccount {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id")
  tenantId     String   @map("tenant_id")
  totalBalance Int      @default(0) @map("total_balance")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("credit_accounts")
}

model CreditLot {
  id              String    @id @default(uuid()) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  source          String
  sourceType      String    @map("source_type")
  initialAmount   Int       @map("initial_amount")
  remainingAmount Int       @map("remaining_amount")
  expiresAt       DateTime? @map("expires_at")
  frozenUntil     DateTime? @map("frozen_until")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([accountId, expiresAt, remainingAmount])
  @@map("credit_lots")
}

model CreditLog {
  id              String        @id @default(uuid()) @db.Uuid
  accountId       String        @map("account_id") @db.Uuid
  type            CreditLogType
  amount          Int
  balanceAfter    Int           @map("balance_after")
  sourceModule    String        @map("source_module")
  sourceResource  String?       @map("source_resource")
  idempotencyKey  String?       @unique @map("idempotency_key")
  traceId         String        @map("trace_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("credit_logs")
}

model AiTask {
  id           String       @id @default(uuid()) @db.Uuid
  taskType     String       @map("task_type")
  userId       String       @map("user_id")
  tenantId     String       @map("tenant_id")
  status       AiTaskStatus @default(queued)
  tier         Int
  confidence   String?
  nextStep     String?      @map("next_step")
  inputHash    String       @map("input_hash")
  modelUsed    String?      @map("model_used")
  providerUsed String?      @map("provider_used")
  cacheHit     Boolean      @default(false) @map("cache_hit")
  costCredits  Int?         @map("cost_credits")
  costRmb      Decimal?     @map("cost_rmb") @db.Decimal(10, 4)
  durationMs   Int?         @map("duration_ms")
  traceId      String       @map("trace_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")
  errorCode    String?      @map("error_code")

  @@index([tenantId, createdAt])
  @@index([taskType, createdAt])
  @@index([traceId])
  @@map("ai_tasks")
}

model AiCostLog {
  id              String   @id @default(uuid()) @db.Uuid
  aiTaskId        String   @unique @map("ai_task_id") @db.Uuid
  inputTokens     Int      @map("input_tokens")
  outputTokens    Int      @map("output_tokens")
  inputCostRmb    Decimal  @map("input_cost_rmb") @db.Decimal(10, 6)
  outputCostRmb   Decimal  @map("output_cost_rmb") @db.Decimal(10, 6)
  totalCostRmb    Decimal  @map("total_cost_rmb") @db.Decimal(10, 4)
  creditsCharged  Int      @map("credits_charged")
  profitRmb       Decimal  @map("profit_rmb") @db.Decimal(10, 4)
  cacheHit        Boolean  @default(false) @map("cache_hit")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ai_cost_logs")
}

model AiProviderHealth {
  id             String   @id @default(uuid()) @db.Uuid
  providerName   String   @unique @map("provider_name")
  status         String
  errorRate5Min  Decimal  @map("error_rate_5min") @db.Decimal(5, 4)
  p95LatencyMs   Int?     @map("p95_latency_ms")
  lastCheckAt    DateTime @map("last_check_at")

  @@map("ai_provider_health")
}

model AiExportAudit {
  id           String   @id @default(uuid()) @db.Uuid
  aiTaskId     String   @map("ai_task_id") @db.Uuid
  inputHash    String   @map("input_hash")
  maskedHash   String   @map("masked_hash")
  providerName String   @map("provider_name")
  fieldCount   Int      @map("field_count")
  traceId      String   @map("trace_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ai_export_audit")
}

model UserDailyCost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  day       DateTime @db.Date
  costRmb   Decimal  @default(0) @map("cost_rmb") @db.Decimal(10, 4)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, day])
  @@map("user_daily_costs")
}

model TenantMonthlyCost {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id")
  month     DateTime @db.Date
  costRmb   Decimal  @default(0) @map("cost_rmb") @db.Decimal(10, 4)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, month])
  @@map("tenant_monthly_costs")
}

model UserDevice {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id")
  tenantId      String           @map("tenant_id")
  deviceType    String           @map("device_type")
  deviceName    String           @map("device_name")
  deviceFinger  String           @map("device_finger")
  lastLoginAt   DateTime         @default(now()) @map("last_login_at")
  lastIp        String?          @map("last_ip")
  status        UserDeviceStatus @default(active)
  revokedAt     DateTime?        @map("revoked_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([userId, deviceFinger])
  @@index([tenantId, userId, status])
  @@index([userId, status])
  @@map("user_devices")
}

model PaymentOrder {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  type            String
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("CNY")
  status          PayStatus @default(pending)
  channel         String
  externalOrderNo String?   @unique @map("external_order_no")
  paidAt          DateTime? @map("paid_at")
  metadata        Json?
  idempotencyKey  String    @unique @map("idempotency_key")
  traceId         String    @map("trace_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId, status])
  @@index([traceId])
  @@map("payment_orders")
}

model PaymentRefund {
  id               String     @id @default(uuid()) @db.Uuid
  orderId          String     @map("order_id") @db.Uuid
  amount           Decimal    @db.Decimal(10, 2)
  tier             RefundTier
  reason           String
  approvalFlowId   String?    @map("approval_flow_id")
  status           String
  externalRefundNo String?    @map("external_refund_no")
  createdAt        DateTime   @default(now()) @map("created_at")
  completedAt      DateTime?  @map("completed_at")

  @@index([orderId, status])
  @@map("payment_refunds")
}

model AutoChargeContract {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id")
  channel            String
  externalContractId String    @unique @map("external_contract_id")
  status             String
  boundAt            DateTime  @default(now()) @map("bound_at")
  revokedAt          DateTime? @map("revoked_at")

  @@index([userId, status])
  @@map("auto_charge_contracts")
}

model AgentCommission {
  id             String           @id @default(uuid()) @db.Uuid
  agentId        String           @map("agent_id")
  clientTenantId String           @map("client_tenant_id")
  type           String
  amount         Decimal          @db.Decimal(10, 2)
  status         CommissionStatus
  sourceOrderId  String           @map("source_order_id")
  freezeUntil    DateTime?        @map("freeze_until")
  settledAt      DateTime?        @map("settled_at")
  paidAt         DateTime?        @map("paid_at")

  @@index([agentId, status])
  @@index([sourceOrderId])
  @@map("agent_commissions")
}

model AgentWithdrawal {
  id               String    @id @default(uuid()) @db.Uuid
  agentId          String    @map("agent_id")
  amount           Decimal   @db.Decimal(10, 2)
  bankCardId       String    @map("bank_card_id")
  approvalFlowId   String?   @map("approval_flow_id")
  status           String
  externalPayoutNo String?   @map("external_payout_no")
  fee              Decimal   @db.Decimal(10, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  paidAt           DateTime? @map("paid_at")

  @@index([agentId, status])
  @@map("agent_withdrawals")
}

model Report {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id")
  userId          String   @map("user_id")
  sourceModule    String   @map("source_module")
  sourceTaskId    String   @map("source_task_id")
  aiTaskType      String   @map("ai_task_type")
  tier            Int
  confidence      String
  nextStep        String   @map("next_step")
  h5Url           String?  @map("h5_url")
  pdfUrl          String?  @map("pdf_url")
  templateVersion Int      @map("template_version")
  brandMode       String   @map("brand_mode")
  agentId         String?  @map("agent_id")
  dataSnapshot    Json     @map("data_snapshot")
  traceId         String   @map("trace_id")
  watermark       String
  deviceLimit     Int      @default(5) @map("device_limit")
  createdAt       DateTime @default(now()) @map("created_at")

  rating ReportRating?
  radar  ReportDifficultyRadar?

  @@index([tenantId, userId, createdAt])
  @@index([traceId])
  @@map("reports")
}

model ReportRating {
  id       String   @id @default(uuid()) @db.Uuid
  reportId String   @unique @map("report_id") @db.Uuid
  stars    Int
  feedback String?
  ratedAt  DateTime @default(now()) @map("rated_at")
  report   Report   @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@map("report_ratings")
}

model ReportTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  sourceModule String   @map("source_module")
  version      Int
  layoutSchema Json     @map("layout_schema")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([sourceModule, version])
  @@index([sourceModule, isActive])
  @@map("report_templates")
}

model ReportEscalation {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  type      String
  status    String
  ticketId  String?  @map("ticket_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId, type])
  @@map("report_escalations")
}

model ReportDifficultyRadar {
  id               String  @id @default(uuid()) @db.Uuid
  reportId         String  @unique @map("report_id") @db.Uuid
  professional     Int
  timeHours        Int     @map("time_hours")
  riskScore        Int     @map("risk_score")
  costScore        Int     @map("cost_score")
  agentAlternative Json    @map("agent_alternative")
  renderedSvg      String? @map("rendered_svg")
  report           Report  @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@map("report_difficulty_radars")
}

model Opportunity {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  source          String
  region          String
  industry        String
  amountEstimate  Decimal  @map("amount_estimate") @db.Decimal(15, 2)
  ownerName       String   @map("owner_name")
  ownerCreditCode String?  @map("owner_credit_code")
  publishDate     DateTime @map("publish_date")
  deadline        DateTime?
  rawUrl          String?  @map("raw_url")
  rawText         String?  @map("raw_text") @db.Text
  meta            Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([region, industry, amountEstimate])
  @@map("opportunities")
}

model OpportunityPreference {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @unique @map("tenant_id")
  regions     Json
  industries  Json
  amountMin   Decimal? @map("amount_min") @db.Decimal(15, 2)
  amountMax   Decimal? @map("amount_max") @db.Decimal(15, 2)
  pushEnabled Boolean  @default(true) @map("push_enabled")

  @@map("opportunity_preferences")
}

model OpportunityMatch {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id")
  opportunityId String    @map("opportunity_id") @db.Uuid
  matchScore    Int       @map("match_score")
  pushedAt      DateTime  @default(now()) @map("pushed_at")
  readAt        DateTime? @map("read_at")
  bookmarked    Boolean   @default(false)

  @@unique([tenantId, opportunityId])
  @@index([tenantId, pushedAt])
  @@map("opportunity_matches")
}

model InvestabilityReport {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id")
  opportunityId      String   @map("opportunity_id") @db.Uuid
  score              Int
  fundingScore       Int      @map("funding_score")
  qualificationScore Int      @map("qualification_score")
  relationshipScore  Int      @map("relationship_score")
  performanceScore   Int      @map("performance_score")
  aiTaskId           String   @unique @map("ai_task_id")
  reportId           String?  @map("report_id")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([tenantId, opportunityId])
  @@map("investability_reports")
}

model OwnerVerifyResult {
  id              String   @id @default(uuid()) @db.Uuid
  ownerCreditCode String   @unique @map("owner_credit_code")
  status          String
  evidence        Json
  score           Int
  cachedUntil     DateTime @map("cached_until")

  @@map("owner_verify_results")
}

model TenderProject {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  name           String
  region         String?
  industry       String?
  amountEstimate Decimal? @map("amount_estimate") @db.Decimal(15, 2)
  sourceFileUrl  String   @map("source_file_url")
  status         String
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId, createdAt])
  @@map("tender_projects")
}

model TenderSummary {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @unique @map("project_id") @db.Uuid
  aiTaskId       String   @unique @map("ai_task_id")
  reportId       String?  @map("report_id")
  keyPoints      Json     @map("key_points")
  schedule       Json
  eligibilityReq Json     @map("eligibility_req")
  scoringSummary Json     @map("scoring_summary")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("tender_summaries")
}

model TenderEligibility {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  status       String

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemConfig {
  id            String                @id @default(uuid()) @db.Uuid
  key           String                @unique
  value         Json
  description   String?
  isOverridable Boolean               @default(true) @map("is_overridable")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  history       SystemConfigHistory[]

  @@map("system_configs")
}

model SystemConfigHistory {
  id             String       @id @default(uuid()) @db.Uuid
  systemConfigId String       @map("system_config_id") @db.Uuid
  oldValue       Json?        @map("old_value")
  newValue       Json         @map("new_value")
  changedBy      String?      @map("changed_by")
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at")
  systemConfig   SystemConfig @relation(fields: [systemConfigId], references: [id], onDelete: Restrict)

  @@index([systemConfigId])
  @@map("system_config_history")
}

model AiTask {
  id           String       @id @default(uuid()) @db.Uuid
  taskType     String       @map("task_type")
  userId       String       @map("user_id")
  tenantId     String       @map("tenant_id")
  status       AiTaskStatus @default(queued)
  tier         Int
  confidence   String?
  nextStep     String?      @map("next_step")
  inputHash    String       @map("input_hash")
  modelUsed    String?      @map("model_used")
  providerUsed String?      @map("provider_used")
  cacheHit     Boolean      @default(false) @map("cache_hit")
  costCredits  Int?         @map("cost_credits")
  costRmb      Decimal?     @map("cost_rmb") @db.Decimal(10, 4)
  durationMs   Int?         @map("duration_ms")
  traceId      String       @map("trace_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")
  errorCode    String?      @map("error_code")

  @@index([tenantId, createdAt])
  @@index([taskType, createdAt])
  @@index([traceId])
  @@map("ai_tasks")
}

model AiCostLog {
  id              String   @id @default(uuid()) @db.Uuid
  aiTaskId        String   @unique @map("ai_task_id") @db.Uuid
  inputTokens     Int      @map("input_tokens")
  outputTokens    Int      @map("output_tokens")
  inputCostRmb    Decimal  @map("input_cost_rmb") @db.Decimal(10, 6)
  outputCostRmb   Decimal  @map("output_cost_rmb") @db.Decimal(10, 6)
  totalCostRmb    Decimal  @map("total_cost_rmb") @db.Decimal(10, 4)
  creditsCharged  Int      @map("credits_charged")
  profitRmb       Decimal  @map("profit_rmb") @db.Decimal(10, 4)
  cacheHit        Boolean  @default(false) @map("cache_hit")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ai_cost_logs")
}

model AiProviderHealth {
  id             String   @id @default(uuid()) @db.Uuid
  providerName   String   @unique @map("provider_name")
  status         String
  errorRate5Min  Decimal  @map("error_rate_5min") @db.Decimal(5, 4)
  p95LatencyMs   Int?     @map("p95_latency_ms")
  lastCheckAt    DateTime @map("last_check_at")

  @@map("ai_provider_health")
}

model AiExportAudit {
  id           String   @id @default(uuid()) @db.Uuid
  aiTaskId     String   @map("ai_task_id") @db.Uuid
  inputHash    String   @map("input_hash")
  maskedHash   String   @map("masked_hash")
  providerName String   @map("provider_name")
  fieldCount   Int      @map("field_count")
  traceId      String   @map("trace_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ai_export_audit")
}

model UserDailyCost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  day       DateTime @db.Date
  costRmb   Decimal  @default(0) @map("cost_rmb") @db.Decimal(10, 4)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, day])
  @@map("user_daily_costs")
}

model TenantMonthlyCost {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id")
  month     DateTime @db.Date
  costRmb   Decimal  @default(0) @map("cost_rmb") @db.Decimal(10, 4)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, month])
  @@map("tenant_monthly_costs")
}

model UserDevice {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id")
  tenantId      String           @map("tenant_id")
  deviceType    String           @map("device_type")
  deviceName    String           @map("device_name")
  deviceFinger  String           @map("device_finger")
  lastLoginAt   DateTime         @default(now()) @map("last_login_at")
  lastIp        String?          @map("last_ip")
  status        UserDeviceStatus @default(active)
  revokedAt     DateTime?        @map("revoked_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([userId, deviceFinger])
  @@index([tenantId, userId, status])
  @@index([userId, status])
  @@map("user_devices")
}

enum AiTaskStatus {
  queued
  processing
  completed
  failed
}

enum UserDeviceStatus {
  active
  revoked
}

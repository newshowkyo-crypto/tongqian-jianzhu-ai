# ============================================================
# 同乾方略·建筑 AI 经营管家 · 开发环境 .env 起步模板
# ============================================================
# 使用方法：
#   1. 复制本文件改名为 .env  →  cp .env.dev.template .env
#   2. 填空所有 ⚠️ 标记的项
#   3. 不要 commit .env（已在 .gitignore）
#   4. 不要发给任何人（包括 AI 助手）
# ============================================================

# ─────────────── 应用基础 ───────────────
NODE_ENV=development
APP_NAME=tongqian-jianzhu-ai
APP_PORT=3000
API_PORT=4000
WORKER_PORT=4100
ADMIN_PORT=3001
AGENT_PORT=3002
GOV_PORT=3003
TZ=Asia/Shanghai

# ─────────────── 数据库（Codex 启动 Docker 自动起）───────────────
DATABASE_URL="postgresql://postgres:tongqian_dev@localhost:5432/tongqian_dev?schema=public"
DATABASE_POOL_MAX=20
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX=tqj_dev:

# ─────────────── ⚠️ AI 模型 P0 必填 ───────────────
# 注意：旧的 key 已泄漏到对话，请去控制台吊销重生后填新 key

# 阿里百炼（M3.12 国产旗舰：qwen3-max / qwen3-vl-max / text-embedding-v3）
ALIYUN_DASHSCOPE_API_KEY=⚠️填阿里百炼新key
DASHSCOPE_API_KEY= # optional alias for local tooling
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenRouter / Claude / GPT（M3.12 已废弃，不再调用）
# OPENROUTER_API_KEY=DEPRECATED_DO_NOT_USE
# OPENROUTER_BASE_URL=DEPRECATED_DO_NOT_USE
# ANTHROPIC_API_KEY=DEPRECATED_DO_NOT_USE
# OPENAI_API_KEY=DEPRECATED_DO_NOT_USE

# DeepSeek 直连（M3.12 旗舰推理：deepseek-reasoner）
DEEPSEEK_API_KEY=⚠️填DeepSeek已充值key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─────────────── ⚠️ 安全密钥 P0 必填 ───────────────
# 生成命令（PowerShell）：
#   [System.Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=⚠️填64位hex随机字符串
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=30d
ENCRYPTION_KEY=⚠️填另一组64位hex随机字符串
CSRF_SECRET=⚠️填一组随机字符串

# ─────────────── ⚠️ 微信支付 P0 必填 ───────────────
# 在 pay.weixin.qq.com → 账户中心 → 商户信息 / API 安全 提取
WECHAT_PAY_MCHID=⚠️10位数字商户号
WECHAT_PAY_API_KEY=⚠️APIv2 32位密钥
WECHAT_PAY_API_V3_KEY=⚠️APIv3 32位密钥
WECHAT_PAY_CERT_PATH=./certs/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.tongqian.io/api/v1/payments/wechat/notify

# ─────────────── ⚠️ 微信公众号 P0 必填 ───────────────
# 在 mp.weixin.qq.com → 设置与开发 → 基本配置 提取
WECHAT_APPID=⚠️wx开头18位
WECHAT_APPSECRET=⚠️32位密钥
WECHAT_TOKEN=⚠️自定32位字符串
WECHAT_AESKEY=⚠️点"随机生成"获得的字符串

# ─────────────── 企业微信（你已有）───────────────
# 在 work.weixin.qq.com → 我的企业 / 应用管理 提取
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=

# ─────────────── 支付宝（你已申请）───────────────
# 在 open.alipay.com → 应用管理 提取
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.tongqian.io/api/v1/payments/alipay/notify

# ─────────────── P1 W4 后逐步补 ───────────────
# 阿里云 OSS / OCR / SLS / 短信（按 PREP-CHECKLIST.md 教程开通）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=tongqian-dev
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OCR_ENDPOINT=https://ocr-api.cn-shanghai.aliyuncs.com
DOC_INTELLIGENCE_ENDPOINT=https://docmind-api.cn-shanghai.aliyuncs.com
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=同乾方略
SMS_TEMPLATE_OTP=

# DashVector（M2 后再开）
DASHVECTOR_ENDPOINT=
DASHVECTOR_API_KEY=
DASHVECTOR_COLLECTION=tongqian_main

# ─────────────── 监控 / 日志 ───────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty
SENTRY_DSN=
OPENTELEMETRY_ENDPOINT=

# ─────────────── 限流 ───────────────
RATE_LIMIT_GLOBAL_PER_SEC=10
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_AI_PER_MIN=30

# ─────────────── 文件上传 ───────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,bmp,tiff

# ─────────────── 业务配置（V4 IMPROVEMENTS）───────────────
# 客户保护期
CUSTOMER_PROTECTION_DAYS=7

# 智能管家分润（接单类）
AGENT_FIRST_YEAR_RATE=0.30
AGENT_NEXT_YEAR_RATE=0.20
AGENT_RECHARGE_RATE=0.15
AGENT_REFER_AGENT_RATE=0.10
CROSS_DISPATCH_RATE=0.05

# PARTNER 智能管家代理人分润（V4 IMPROVEMENTS · 二期 M4 启用）
PARTNER_SUBSCRIPTION_RATE=0.05
PARTNER_TOPUP_RATE=0.03
PARTNER_REFER_AGENT_RATE=0.05
PARTNER_REFER_AGENT_BONUS=100
PARTNER_REFER_TONGQIAN_RATE=0.05
PARTNER_YEAR_LIMIT_OWNERS=50
PARTNER_YEAR_LIMIT_AGENTS=20
PARTNER_ACTIVATION_DAYS=30
FEATURE_FLAG_PARTNER_ENABLED=false

# 提现门槛
WITHDRAW_MIN_AMOUNT=100

# AI 单点成本默认值（元/百万 tokens，可在后台覆盖）
COST_QWEN3_MAX_INPUT=20
COST_QWEN3_MAX_OUTPUT=60
COST_QWEN3_VL_MAX_INPUT=30
COST_QWEN3_VL_MAX_OUTPUT=90
COST_TEXT_EMBEDDING_V3_INPUT=0.7
COST_DEEPSEEK_REASONER_INPUT=4
COST_DEEPSEEK_REASONER_OUTPUT=16

# ─────────────── 公开域名 ───────────────
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_ADMIN_URL=http://localhost:3001
PUBLIC_AGENT_URL=http://localhost:3002
PUBLIC_GOV_URL=http://localhost:3003
